# ---- 기본 ----
APP_ENV=development            # production 에서는 JWT_SECRET 필수
DATABASE_URL=postgresql+psycopg://meetingmate:meetingmate@localhost:5432/meetingmate
JWT_SECRET=                    # 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAILS=                  # 관리자 권한을 줄 이메일 (콤마 구분)

# ---- AI (비워두면 Mock AI 사용) ----
AI_PROVIDER=auto               # auto | openai | mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_CHARS=60000

# ---- Email (비워두면 Mock: 실제 발송 안 함) ----
EMAIL_PROVIDER=auto            # auto | resend | mock
RESEND_API_KEY=
EMAIL_FROM=Meeting Mate <onboarding@resend.dev>

# ---- 프론트엔드 / CORS ----
FRONTEND_URL=http://localhost:5173       # 이메일 속 개인 브리핑 링크에 사용
CORS_ORIGINS=http://localhost:5173       # 콤마 구분
DISPLAY_TIMEZONE=Asia/Seoul              # 이메일 속 일시 표시 시간대

# ---- 업로드 / 스케줄러 ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
TASK_REMINDER_DAYS_BEFORE=1    # 후속 업무 마감 N일 전부터 알림 (1회)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
